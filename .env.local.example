# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — copy to .env when running the API directly with Python
# (i.e. NOT via docker compose up)
#
# When running inside Docker Compose, use .env.example instead (OLLAMA_BASE_URL
# points at the "ollama" container hostname).
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# Local Python run: Ollama is reachable on localhost
OLLAMA_BASE_URL=http://localhost:11434

# Keep sovereign mode on — no cloud AI APIs required
SOVEREIGN_MODE=true

# Data paths (relative to repo root; created automatically at startup)
# DATA_DIR=data

